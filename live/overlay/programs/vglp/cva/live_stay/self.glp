%% The live harness of the canonical CVA platform of STAY (platform.vglp,
%% as cascade.sh prints it): four persons, alice, bob, carol and dave, in one
%% heap, their networks joined; the host (the live server) is every person, and feeds each agent the day by cal(Person, N).
%% Generated by gen_harness.py; the types are the platform's, copied.

Class ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
mint_coin(Peer, Integer)
;
mint_bond(Peer, Integer, Integer)
;
first_date(Peer, Integer)
;
advance(Peer, Integer)
;
swap_cc(Peer, Peer, Peer, Integer, Peer, Integer)
;
swap_cb(Peer, Peer, Peer, Integer, Peer, Integer, Integer)
;
swap_bc(Peer, Peer, Peer, Integer, Integer, Peer, Integer)
;
swap_bb(Peer, Peer, Peer, Integer, Integer, Peer, Integer, Integer)
;
pay(Peer, Peer, Integer)
;
redeem_cc(Peer, Peer, Peer)
;
redeem_cb(Peer, Peer, Peer, Integer)
;
redeem_bc(Peer, Peer, Integer, Peer)
;
redeem_bb(Peer, Peer, Integer, Peer, Integer)
;
deposit_c(Peer, Peer, Peer, Integer)
;
deposit_b(Peer, Peer, Peer, Integer, Integer)
;
release_c(Peer, Peer, Peer, Integer)
;
release_b(Peer, Peer, Peer, Integer, Integer)
;
return_c(Peer, Peer, Peer, Integer)
;
return_b(Peer, Peer, Peer, Integer, Integer)
;
list_place(Peer, Speech)
;
book(Peer, Peer, Speech, Integer, Integer)
;
cancel(Peer, Peer, Speech, Integer, Integer)
;
review(Peer, Peer, Speech, Integer, Speech)
.
Proposal ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
mint_coin(Peer, Integer)
;
mint_bond(Peer, Integer, Integer)
;
swap_cc(Peer, Peer, Peer, Integer, Peer, Integer)
;
swap_cb(Peer, Peer, Peer, Integer, Peer, Integer, Integer)
;
swap_bc(Peer, Peer, Peer, Integer, Integer, Peer, Integer)
;
swap_bb(Peer, Peer, Peer, Integer, Integer, Peer, Integer, Integer)
;
pay(Peer, Peer, Integer)
;
redeem_cc(Peer, Peer, Peer)
;
redeem_cb(Peer, Peer, Peer, Integer)
;
redeem_bc(Peer, Peer, Integer, Peer)
;
redeem_bb(Peer, Peer, Integer, Peer, Integer)
;
deposit_c(Peer, Peer, Peer, Integer)
;
deposit_b(Peer, Peer, Peer, Integer, Integer)
;
release_c(Peer, Peer, Peer, Integer)
;
release_b(Peer, Peer, Peer, Integer, Integer)
;
return_c(Peer, Peer, Peer, Integer)
;
return_b(Peer, Peer, Peer, Integer, Integer)
;
list_place(Peer, Speech)
;
book(Peer, Peer, Speech, Integer, Integer)
;
cancel(Peer, Peer, Speech, Integer, Integer)
;
review(Peer, Peer, Speech, Integer, Speech)
.
Request ::= propose(Proposal).
Atom ::=
identity
;
knows(Peer)
;
coin(Peer)
;
bond(Peer, Integer)
;
date(Integer)
;
dated
;
place(Speech)
;
stay(Speech, Peer, Integer)
;
booked(Speech, Integer)
;
guest(Peer, Speech, Integer)
;
paid(Speech, Integer)
;
reviewed(Speech, Integer)
;
review(Speech, Peer, Speech)
.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
YesNo     ::= yes ; no.
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; request(Rho, Integer).
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
Asking    ::= Attempt ; hello(Peer, Proposal).
Approval  ::= approval(Asking, List(Word), YesNo?).
Word      ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Integer).
Menu      ::= menu(Key, List(Key), Request?).
Approved  ::= Proposal.
Output    ::= view(List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab       ::= tab(String, Constant) ; tab(String, Constant, Constant).

Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).
HostIn   ::= [_ | HostIn].

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Integer)?, Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure live_ui(Key?, HostIn?, Stream(_)?).
live_ui(_, Ins, _) :-
    split4(Ins?, GA, GB, GC, GD, KA, KB, KC, KD),
    platform # agent(alice, InA?, OutA, TA, KA?, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    tag(alice, DA?, SA),
    platform # agent(bob, InB?, OutB, TB, KB?, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    tag(bob, DB?, SB),
    platform # agent(carol, InC?, OutC, TC, KC?, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    tag(carol, DC?, SC),
    platform # agent(dave, InD?, OutD, TD, KD?, AsD),
    platform # dispatch(AsD?, ch(GD?, DD), MD),
    to_person(MD?, TD?),
    tag(dave, DD?, SD),
    merge(OutA?, OutB?, Net1),
    merge(OutC?, OutD?, Net2),
    merge(Net1?, Net2?, Net),
    route4(Net?, alice, InA, bob, InB, carol, InC, dave, InD, N),
    tag_net(N?, SN),
    merge(SA?, SB?, S1),
    merge(SC?, SD?, S2),
    merge(S1?, S2?, S3),
    merge(S3?, SN?, S),
    send_to_user(S?).

procedure split4(HostIn?, PersonIn(Drawn), PersonIn(Drawn), PersonIn(Drawn), PersonIn(Drawn),
    Stream(Integer), Stream(Integer), Stream(Integer), Stream(Integer)).
split4([in(alice, G)|Ins], [G?|A?], B?, C?, D?, KA?, KB?, KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([in(bob, G)|Ins], A?, [G?|B?], C?, D?, KA?, KB?, KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([in(carol, G)|Ins], A?, B?, [G?|C?], D?, KA?, KB?, KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([in(dave, G)|Ins], A?, B?, C?, [G?|D?], KA?, KB?, KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([cal(alice, N)|Ins], A?, B?, C?, D?, [N?|KA?], KB?, KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([cal(bob, N)|Ins], A?, B?, C?, D?, KA?, [N?|KB?], KC?, KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([cal(carol, N)|Ins], A?, B?, C?, D?, KA?, KB?, [N?|KC?], KD?) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([cal(dave, N)|Ins], A?, B?, C?, D?, KA?, KB?, KC?, [N?|KD?]) :- split4(Ins?, A, B, C, D, KA, KB, KC, KD).
split4([_|Ins], A?, B?, C?, D?, KA?, KB?, KC?, KD?) :- otherwise | split4(Ins?, A, B, C, D, KA, KB, KC, KD).

procedure tag(Peer?, Stream(_)?, Stream(_)).
tag(N, [X|Xs], [d(N?, X?)|Ts?]) :- ground(N?) | tag(N?, Xs?, Ts).
tag(_, [], []).

procedure tag_net(Stream(_)?, Stream(_)).
tag_net([X|Xs], [net(X?)|Ts?]) :- tag_net(Xs?, Ts).
tag_net([], []).
